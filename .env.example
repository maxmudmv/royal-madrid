# ==============================================================================
# ROYAL MADRID — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and fill in real values. NEVER commit .env to Git.
# ==============================================================================

# 1. PostgreSQL Database Connection (Supabase Free or Local PostgreSQL 18)
# Example local: postgresql://postgres@localhost:5433/royal_madrid
# Example Supabase: postgresql://postgres.[project-ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql://postgres@localhost:5433/royal_madrid"

# 2. Admin Panel Authentication (Server-side only, never exposed to client)
# Set a strong password and signing secret for the administrator session cookie
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-strong-admin-password-in-production"
ADMIN_SESSION_SECRET="replace-with-64-char-random-hex-secret-for-hmac-signing"

# 3. Scheduled Synchronization & Cron Protection Secret
# Used to authenticate requests to /api/cron/sync (e.g. from Vercel Cron or GitHub Actions)
CRON_SECRET="replace-with-strong-cron-bearer-secret"

# 4. Optional External Football Data Providers (Server-side only, Free Tiers)
# OpenFootball (CC0-1.0 Public Domain) works out-of-the-box with zero API keys.
# Optional: football-data.org Free Tier API Token (10 req/min, La Liga 'PD' & UCL 'CL')
FOOTBALL_DATA_ORG_API_KEY=""

# Optional: API-Football (api-sports.io) Free Plan Key (100 req/day, 10 req/min)
API_FOOTBALL_KEY=""
API_FOOTBALL_DAILY_QUOTA="100"
